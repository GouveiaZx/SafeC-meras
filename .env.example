# ========================================
# CONFIGURAÇÕES DO PROJETO NEWCAM - EXEMPLO
# Sistema de Vigilância por Câmeras IP
# ========================================
# 
# Copie este arquivo para .env e preencha com seus valores reais
#

# Configurações da Aplicação
NODE_ENV=development
PORT=3002
API_PORT=3002
WORKER_PORT=3003

# ========================================
# JWT E SEGURANÇA
# ========================================
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-refresh-jwt-secret-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# CONFIGURAÇÕES DE MÍDIA E STREAMING
# ========================================
RTSP_PORT=554
RTMP_PORT=1936
HLS_PORT=8080
STREAM_QUALITY=720p
RECORDING_SEGMENT_DURATION=300
HLS_SEGMENT_DURATION=10
MAX_CONCURRENT_STREAMS=50

# Servidores de Streaming (Desenvolvimento Local)
SRS_API_URL=http://localhost:1985/api/v1
SRS_HTTP_PORT=8081
SRS_RTMP_PORT=1936
SRS_SERVER_HOST=localhost
SRS_API_SECRET=
SRS_WEBHOOK_SECRET=
ZLM_API_URL=http://localhost:8000/index/api
ZLM_SECRET=your-zlmediakit-secret
ZLM_BASE_URL=http://localhost:8000
STREAMING_SERVER=zlm

# SRS Dynamic RTMP Pool Configuration
SRS_STREAM_APP=live
SRS_STREAM_KEY_PREFIX=stream
SRS_STREAM_KEY_PADDING=3
RTMP_POOL_SIZE=100
RTMP_POOL_REFILL_THRESHOLD=10

# ========================================
# CONFIGURAÇÕES DE MONITORAMENTO
# ========================================
CAMERA_HEALTH_CHECK_INTERVAL=30
OFFLINE_ALERT_THRESHOLD=120
STORAGE_CLEANUP_INTERVAL=3600
DEFAULT_RETENTION_DAYS=30
MAX_RECORDING_SIZE_GB=100

# ========================================
# REDIS (CACHE E FILAS)
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# ========================================
DEBUG=true
LOG_LEVEL=debug
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3002
BACKEND_BASE_URL=http://localhost:3002

# ========================================
# CONFIGURAÇÕES DE PERFORMANCE
# ========================================
MAX_UPLOAD_SIZE_MB=500
MAX_CONCURRENT_UPLOADS=10
CACHE_TTL_SECONDS=300
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ========================================
# CONFIGURAÇÕES DE LOGS
# ========================================
LOG_FILE_PATH=./storage/logs/newcam.log
LOG_MAX_SIZE_MB=100
LOG_MAX_FILES=10
LOG_ROTATION_INTERVAL=daily

# ========================================
# CONFIGURAÇÕES DE ARMAZENAMENTO LOCAL
# ========================================
LOCAL_STORAGE_PATH=./storage
TEMP_UPLOAD_PATH=./storage/temp
HLS_OUTPUT_PATH=./storage/hls
RECORDING_OUTPUT_PATH=./storage/recordings

# ========================================
# S3 UPLOAD CONFIGURATION
# ========================================
S3_UPLOAD_ENABLED=true
S3_UPLOAD_CONCURRENCY=2
ENABLE_UPLOAD_QUEUE=true
PREFER_S3_STREAMING=false
DELETE_LOCAL_AFTER_UPLOAD=false

# ========================================
# CONFIGURAÇÕES DE BACKUP E SEGURANÇA
# ========================================
BACKUP_INTERVAL_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
SESSION_TIMEOUT_MINUTES=60
INTERNAL_SERVICE_TOKEN=your-internal-service-token
WORKER_TOKEN=your-worker-token

# ========================================
# CONFIGURAÇÕES DE NOTIFICAÇÕES
# ========================================
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_RETRY_ATTEMPTS=3

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# Obtenha suas credenciais em: https://app.supabase.com/
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ========================================
# ARMAZENAMENTO WASABI S3
# ========================================
# Obtenha suas credenciais em: https://wasabi.com/
WASABI_ACCESS_KEY=your-wasabi-access-key
WASABI_SECRET_KEY=your-wasabi-secret-key
WASABI_BUCKET=your-bucket-name
WASABI_REGION=us-east-1
WASABI_ENDPOINT=https://s3.wasabisys.com

# Configurações de Upload S3
ENABLE_S3_UPLOAD=true
S3_UPLOAD_RETRY_ATTEMPTS=3
S3_UPLOAD_TIMEOUT_MS=30000
S3_UPLOAD_CHUNK_SIZE_MB=5